# Copy this file to utils/configs/paths.env and fill in your machine-local settings.
# paths.env may contain private paths and API keys; it is never committed.

# ---- Runtime -----------------------------------------------------------------
# GUI_CC_ROOT=/path/to/gui-cc
PYTHON_BIN=python3
GUI_CC_CONDA_ENV=
VLLM_BIN=vllm

# ---- OpenAI-compatible endpoints ---------------------------------------------
# Used by the VLM judge and by the online probing agent. Point these at your own
# endpoint or proxy if you are not calling the official API.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Optional: extra request fields for the judge, as a JSON object. Empty by default so that
# any OpenAI-compatible endpoint works. Some providers expose a switch to skip a reasoning
# phase the judge does not need, for example:
#   JUDGE_EXTRA_BODY_JSON={"enable_thinking": false}
JUDGE_EXTRA_BODY_JSON=

# Optional: a separate endpoint for closed HTML-generating world models.
# Falls back to OPENAI_BASE_URL / OPENAI_API_KEY when unset.
CLOSED_MODEL_BASE_URL=
CLOSED_MODEL_API_KEY=

# ---- Local vLLM service ------------------------------------------------------
CODE2WORLD_URL=http://localhost:4244/v1
CODE2WORLD_CKPT=

# ---- Qwen-Image-Edit-2511 (direct image generation) --------------------------
# Requires a local DiffSynth-Studio checkout; pin it to the commit used in the
# paper, since the pipeline version changes the output pixels:
#   git clone https://github.com/modelscope/DiffSynth-Studio.git
#   git -C DiffSynth-Studio checkout 5bccd60c803e421d5d9ed6b6a449df4a4f17d9e2
DIFFSYNTH_DIR=
QWEN_IMAGE_EDIT_2511_DIR=

# ---- Model revisions ---------------------------------------------------------
# Optional but recommended: these identifiers enter the run fingerprint, so the
# records show which weights produced a given result.
CODE2WORLD_REVISION=
QWEN_IMAGE_EDIT_REVISION=

# ---- Visual similarity encoders (S_sig / S_dino) -----------------------------
# Defaults match the paper; override to use a different checkpoint or a local copy.
VISUAL_SIM_SIGLIP_MODEL=google/siglip-so400m-patch14-384
VISUAL_SIM_DINO_MODEL=facebook/dinov2-giant
VISUAL_SIM_SIGLIP_REVISION=
VISUAL_SIM_DINO_REVISION=
VISUAL_SIM_DEVICE=

# ---- vLLM runtime tweaks -----------------------------------------------------
# Set to 0 on runtime nodes without a CUDA toolkit / nvcc.
VLLM_USE_FLASHINFER_SAMPLER=0
# Keep vLLM's AF_UNIX RPC endpoint below the 107-byte socket path limit.
VLLM_RPC_BASE_PATH=/tmp
